// ==========================================
// DATA ENGINE & OBSERVABILITY MODELS
// ==========================================

model SyncJob {
  id             String    @id @default(cuid())
  provider       String    @default("anilist") // "anilist", "jikan"
  jobType        String // "FULL_CATALOG", "INCREMENTAL", "AIRING", "SEASONAL", "UPCOMING", "HISTORICAL", "REPAIR"
  status         String    @default("PENDING") // "PENDING", "RUNNING", "COMPLETED", "FAILED", "PAUSED", "CANCELLED"
  totalItems     Int?      @default(0)
  processedCount Int       @default(0)
  createdCount   Int       @default(0)
  updatedCount   Int       @default(0)
  failedCount    Int       @default(0)
  error          String?
  cursor         String?
  page           Int?      @default(1)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  // BullMQ queue tracking (added for the background job queue — see
  // src/lib/queue/**). A SyncJob row is created PENDING at enqueue time,
  // then the queue worker updates the same row as it runs, so admin UI
  // consumers (e.g. GET /api/admin/anime/import, /api/admin/datacenter)
  // keep working against this table unchanged.
  bullJobId       String? // BullMQ job id in the shared "otakuva-sync" queue
  mode            String? // job-kind-specific mode, e.g. import mode TOP/SEASON/AIRING/...
  attempts        Int     @default(0) // attempts made so far this BullMQ job
  maxAttempts     Int     @default(5) // matches the queue's default attempts (exponential backoff)
  processedPages  Int     @default(0)
  failedPagesJson String? // JSON array of page numbers that errored (paged jobs only)
  failedIdsJson   String? // JSON array of external ids that failed (paged jobs only)
  payloadJson     String? // JSON snapshot of the request that created this job, for resume/audit

  checkpoints SyncCheckpoint[]

  @@index([provider, jobType])
  @@index([status])
}

model SyncCheckpoint {
  id              String   @id @default(cuid())
  syncJobId       String?
  provider        String
  jobType         String
  page            Int      @default(1)
  cursor          String?
  lastProcessedId String?
  processedCount  Int      @default(0)
  createdCount    Int      @default(0)
  updatedCount    Int      @default(0)
  failedCount     Int      @default(0)
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  syncJob SyncJob? @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@unique([provider, jobType])
  @@index([provider, jobType])
}

model DataSourceRecord {
