// ==========================================
// WORLD 2 — USER TRACKING & PERSONAL DATA
// ==========================================

model User {
  id                    String    @id @default(cuid())
  username              String    @unique
  displayName           String? // Optional public name, e.g. "Victor Winters" (≤40 chars); username stays the handle
  // Optional since phone sign-up (2026-10-16): accounts created by phone +
  // OTP have no email. Legacy email/password accounts keep theirs (used for
  // the one-time legacy sign-in and password reset).
  email                 String?   @unique
  // Every account signs in with username + password (2026-10-28). Null only
  // for phone accounts made before that — they set one via "Forgot password".
  passwordHash          String?
  // Set whenever the password changes; phone-verified passes issued earlier
  // are refused, so a reset pass works once.
  passwordChangedAt     DateTime?
  lastLoginAt           DateTime?
  // Touched (at most every few minutes) by GET /api/auth/me — "active users".
  lastSeenAt            DateTime?
  // E.164 (e.g. "+919876543210"). One account per number — that's the point:
  // it is what stops one person running many accounts to move ratings.
  phone                 String?   @unique
  // Set once the user proves they own `phone` with an SMS OTP. Rating,
  // reviewing and posting are gated on this (requireVerifiedUser() in
  // src/lib/auth.ts); legacy accounts without a phone stay locked out of
  // those until they link one.
  phoneVerifiedAt       DateTime?
  // DEPRECATED (2026-10-16): email verification was removed in favour of
  // phone verification. No longer read or written; drop in a later
  // contract migration together with EmailVerificationToken.
  emailVerifiedAt       DateTime?
  avatarUrl             String?
  avatarAssetId         String?
  bannerUrl             String?
  bannerAssetId         String?
  bio                   String?
  // Platform-level RBAC role. One of: USER, MODERATOR, NEWS_EDITOR,
  // DATA_EDITOR, MEDIA_MANAGER, ADMIN, SUPER_ADMIN. See src/lib/roles.ts
  // for the canonical list and hierarchy. Distinct from per-community
  // roles (see CommunityMember.role), which are scoped to one community.
  role                  String    @default("USER")
  // Creator Mode (2026-10-24): set when a USER upgrades to CREATOR through
  // POST /api/creator/upgrade (src/lib/creator/creatorService.ts). Kept when
  // an admin later changes the role, as a record of when it was granted.
  creatorSince          DateTime?
  creatorChannelName    String?
  creatorChannelUrl     String?
  // Privacy: list the communities this user JOINED on their public profile.
  // Communities they founded are always shown regardless.
  showJoinedCommunities Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Tracking & Library
  library             UserAnime[]
  episodeProgress     UserEpisodeProgress[]
  episodeWatches      UserEpisodeWatch[]
  ratings             AnimeRating[]
  ratingEvents        RatingEvent[]
  ratingRiskSignals   RatingRiskSignal[]
  episodeRatings      EpisodeRating[]
  favorites           Favorite[]
  reviews             Review[]
  articles            UserArticle[]
  articleLikes        UserArticleLike[]
  articleComments     UserArticleComment[]
  articleCommentLikes UserArticleCommentLike[]
  reviewReplies       ReviewReply[]
  reviewLikes         ReviewLike[]
  reviewReports       ReviewReport[]
  customLists         UserList[]
  activities          Activity[]
  mediaAssets         MediaAsset[]
  commentMedia        CommentMedia[]
  notifications       Notification[]
  followers           Follow[]                 @relation("Following")
  following           Follow[]                 @relation("Followers")

  // Social & Community Layer
  ownedCommunities       Community[]             @relation("CommunityOwner")
  communityMemberships   CommunityMember[]
  joinRequests           CommunityJoinRequest[]
  communityBans          CommunityBan[]
  discussions            Discussion[]            @relation("DiscussionAuthor")
  discussionComments     DiscussionComment[]     @relation("CommentAuthor")
  discussionFollows      DiscussionFollower[]
  discussionReactions    DiscussionReaction[]
  commentReactions       CommentReaction[]
  communityMessages      CommunityMessage[]
  reportsCreated         Report[]                @relation("UserReports")
  moderatorActions       ModerationAction[]      @relation("ModeratorActions")
  correctionRequests     DataCorrectionRequest[]
  auditLogs              AuditLog[]              @relation("AuditActor")
  studioAuditLogs        StudioAuditLog[]
  authoredStudioVersions StudioVersion[]
  uploadedStudioMedia    StudioMedia[]           @relation("StudioMediaUploader")
  studioMergesInitiated  StudioMerge[]           @relation("StudioMergeInitiator")
  pollVotes              PollVote[]
  passwordResetTokens    PasswordResetToken[]
  sponsorAds              SponsorAd[]

  // Reviewer badges (src/lib/badges). Volume tiers are derived from
  // badgeStats.countedReviewCount; UserBadge is for future specialty/seasonal badges.
  badgeStats              UserBadgeStats?
  badges                  UserBadge[]
  badgeEvents             BadgeEvent[]
  emailVerificationTokens EmailVerificationToken[]

  // Direct & Group Real-time Messaging
  conversationMemberships ConversationParticipant[]
  messagesSent            Message[]
  messageReactions        MessageReaction[]

  // Standardized Event Stream
  eventLogs                 EventLog[]
  tasteProfile              UserTasteProfile?
  interestClusters          UserInterestCluster[]
  recommendationSessions    RecommendationSession[]
  recommendationFeedback    RecommendationFeedback[]
  recommendationPredictions RecommendationPrediction[]
  scheduleReminders         ScheduleReminder[]

  hypes AnimeHype[]
  vibes AnimeVibe[]

  @@index([role])
  @@index([lastSeenAt])
}

// Records sensitive/privileged actions (role changes today; extend as more
// admin actions need a trail). Do not log secrets or password data here.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. "USER_ROLE_CHANGE"
  entityType String // e.g. "User"
  entityId   String
  beforeJson String? // JSON-encoded prior state, when applicable
  afterJson  String? // JSON-encoded new state, when applicable
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// Password reset tokens. The raw token is a cryptographically random value
// (crypto.randomBytes(32).toString('hex') — see src/lib/security/tokens.ts)
// generated for one request, emailed once, and never stored — only its
// SHA-256 hash lives here, so a DB read/leak alone can't be used to reset
// anyone's password. Single-use: usedAt is set the moment it's consumed
// and every check requires usedAt IS NULL. Expires 1 hour after creation
// (see PASSWORD_RESET_TOKEN_TTL_MS in src/lib/security/tokens.ts).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?

  @@index([userId])
  @@index([expiresAt])
}

// DEPRECATED (2026-10-16), unused since phone verification replaced email
// verification; drop in a later contract migration.
// Email verification tokens — same shape/guarantees as PasswordResetToken
// (random raw token, only its hash stored, single-use via usedAt) but a
// longer TTL (24h; see EMAIL_VERIFICATION_TOKEN_TTL_MS). Consuming one sets
// User.emailVerifiedAt.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  email     String // the address this token verifies — re-checked against the user's current email at confirm time, in case it changed after the token was issued
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model UserAnime {
  id              String    @id @default(cuid())
  userId          String
  animeId         String
  status          String // "WATCHING", "COMPLETED", "ON_HOLD", "DROPPED", "PLAN_TO_WATCH"
  episodesWatched Int       @default(0)
  score           Float?
  notes           String?
  startDate       DateTime?
  finishDate      DateTime?
  favorite        Boolean   @default(false)
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([userId, status])
  @@index([animeId])
}

/// Per-episode "watched" ticks keyed by episode number (2026-10-21) — for
/// anime with no Episode rows (most of the catalog), where
/// UserEpisodeProgress (needs an Episode id) can't be used. One row per
/// watched episode; UserAnime.episodesWatched is kept equal to the count.
model UserEpisodeWatch {
  id            String   @id @default(cuid())
  userId        String
  animeId       String
  episodeNumber Int
  watchedAt     DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId, episodeNumber])
  @@index([userId, animeId])
}

model UserEpisodeProgress {
  id            String    @id @default(cuid())
  userId        String
  animeId       String
  episodeId     String
  episodeNumber Float     @default(1)
  status        String    @default("COMPLETED") // "STARTED", "COMPLETED"
  startedAt     DateTime?
  completedAt   DateTime?
  watchedAt     DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime   Anime   @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId, animeId])
  @@index([userId, status])
}

model AnimeRating {
  id        String    @id @default(cuid())
  userId    String
  animeId   String
  rating    Float // 1.0 to 10.0 in 0.1 increments
  deletedAt DateTime? // Soft delete support for audit and historical preservation
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime          Anime                 @relation(fields: [animeId], references: [id], onDelete: Cascade)
  categoryScores RatingCategoryScore[]
  events         RatingEvent[]

  @@unique([userId, animeId])
  @@index([animeId])
  @@index([userId])
  @@index([deletedAt])
}

model RatingCategoryScore {
  id        String   @id @default(cuid())
  ratingId  String
  category  String // "STORY", "CHARACTERS", "ANIMATION", "DIRECTION", "MUSIC", "ENJOYMENT"
  score     Float // 1.0 to 10.0 in 0.1 increments
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rating AnimeRating @relation(fields: [ratingId], references: [id], onDelete: Cascade)

  @@unique([ratingId, category])
  @@index([category, score])
  @@index([ratingId])
}

model RatingEvent {
  id                 String   @id @default(cuid())
  ratingId           String?
  userId             String
  animeId            String
  previousScore      Float?
  newScore           Float
  eventType          String // "CREATED", "UPDATED", "DELETED", "FLAGGED", "RESTORED"
  categoryScoresJson String? // Serialized JSON of category scores snapshot
  ipHash             String?
  userAgent          String?
  createdAt          DateTime @default(now())

  rating AnimeRating? @relation(fields: [ratingId], references: [id], onDelete: SetNull)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime  Anime        @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([animeId, createdAt])
  @@index([userId])
  @@index([eventType])
}

model RatingAggregate {
  id                String   @id @default(cuid())
  animeId           String   @unique
  ratingCount       Int      @default(0)
  rawAverage        Float?
  medianScore       Float?
  bayesianScore     Float? // OTAKUVA Official Score
  variance          Float?
  standardDeviation Float?
  confidence        String   @default("NO_DATA") // "NO_DATA", "EARLY", "LOW", "MEDIUM", "HIGH"
  distributionJson  String? // JSON bucket counts { "1": 0, "2": 0, ... "10": 0 }
  algorithmVersion  Int      @default(1)
  updatedAt         DateTime @updatedAt

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([bayesianScore])
  @@index([ratingCount])
}

model RatingCategoryAggregate {
  id                String   @id @default(cuid())
  animeId           String
  category          String // "STORY", "CHARACTERS", "ANIMATION", "DIRECTION", "MUSIC", "ENJOYMENT"
  responseCount     Int      @default(0)
  averageScore      Float?
  medianScore       Float?
  variance          Float?
  standardDeviation Float?
  percentageShare   Float? // Normalized percentage (deterministic Hare-Niemeyer adjusted)
  confidence        String   @default("NO_DATA") // "NO_DATA", "EARLY", "LOW", "MEDIUM", "HIGH"
  updatedAt         DateTime @updatedAt

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([animeId, category])
  @@index([animeId])
  @@index([category])
}

model RatingRiskSignal {
  id          String   @id @default(cuid())
  userId      String
  animeId     String
  riskScore   Float    @default(0.0)
  signalType  String // "VELOCITY_SPIKE", "UNUSUAL_PATTERN", "SUSPICIOUS_BURST"
  detailsJson String?
  status      String   @default("PENDING") // "PENDING", "REVIEWED", "DISMISSED"
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([animeId])
  @@index([userId])
}

// Per-episode ratings (2026-10-19 rework): a member rates episodes as they
// air; their score for the anime is the average of their episode ratings
// (src/lib/rating/episodeRatings.ts). Keyed by anime + episode number so an
// episode can be rated even when the catalog has no Episode row for it —
// the number is only accepted once that episode has aired. episodeId is
// filled when an Episode row exists.
model EpisodeRating {
  id            String   @id @default(cuid())
  userId        String
  episodeId     String?
  animeId       String?
  episodeNumber Int?
  rating        Float? // Legacy per-episode score (0.5–10); new ratings use retention
  retention     Int? // 0–100: how much this episode kept the member hooked
  review        String? // Optional short note about this episode
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode        Episode?                     @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  anime          Anime?                       @relation(fields: [animeId], references: [id], onDelete: Cascade)
  categoryScores EpisodeRatingCategoryScore[]

  @@unique([userId, episodeId])
  @@unique([userId, animeId, episodeNumber])
  @@index([episodeId])
  @@index([animeId, episodeNumber])
}

// Optional aspect scores (Story, Characters…) given to one episode.
model EpisodeRatingCategoryScore {
  id              String   @id @default(cuid())
  episodeRatingId String
  category        String // one of ACTIVE_RATING_CATEGORIES
  score           Float // 1.0 to 10.0
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  episodeRating EpisodeRating @relation(fields: [episodeRatingId], references: [id], onDelete: Cascade)

  @@unique([episodeRatingId, category])
  @@index([category])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([userId])
}

model Review {
  id                      String    @id @default(cuid())
  userId                  String
  animeId                 String
  episodeId               String?
  seasonId                String?
  ratingId                String?
  reviewType              String    @default("ANIME_REVIEW") // "ANIME_REVIEW", "EPISODE_REVIEW", "SEASON_REVIEW"
  title                   String
  body                    String
  rating                  Float?
  containsSpoiler         Boolean   @default(false)
  spoilerLevel            String    @default("SPOILER_FREE") // "SPOILER_FREE", "MILD_SPOILERS", "SPOILERS", "FULL_SPOILERS"
  watchStatusAtReview     String?
  episodeProgressAtReview Int?
  edited                  Boolean   @default(false)
  likesCount              Int       @default(0)
  pinnedAt                DateTime? // Pinned to the top of the anime's reviews by a moderator
  pinnedById              String?
  status                  String    @default("PUBLISHED") // "PUBLISHED", "DRAFT" (creator drafts — never public), "PENDING_REVIEW", "HIDDEN", "REMOVED", "DELETED"
  // Stamped by the server when a CREATOR publishes it (never from client input).
  isCreatorReview         Boolean   @default(false)
  language                String    @default("en")
  languageConfidence      Float     @default(1.0)
  overallSentiment        String    @default("POSITIVE") // "POSITIVE", "MIXED", "NEGATIVE", "NEUTRAL"
  sentimentConfidence     Float     @default(1.0)
  analysisModelVersion    Int       @default(1)
  analysisStatus          String    @default("COMPLETED") // "PENDING", "COMPLETED", "FAILED"
  deletedAt               DateTime?
  // Reviewer-badge counting (src/lib/badges/countingService.ts). Separate from
  // `status` above, which is publication/moderation state. null = not yet
  // evaluated (rows that pre-date the badge system; see
  // scripts/badges/backfill_counting.ts). "PENDING" -> "COUNTED" after the
  // maturity window and the spam/duplicate check; "REMOVED" if it fails or is
  // later removed for spam/fraud; "INELIGIBLE" if it never met the rules
  // (too short, no watch status, not an anime-level review).
  wordCount               Int       @default(0)
  countState              String?
  countedAt               DateTime?
  countRemovalReason      String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime          Anime           @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episode        Episode?        @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  likes          ReviewLike[]
  aspects        ReviewAspect[]
  reports        ReviewReport[]
  reviewAnalysis ReviewAnalysis?
  replies        ReviewReply[]
  tags           ReviewTag[]

  @@unique([userId, animeId])
  @@index([animeId, createdAt])
  @@index([animeId, isCreatorReview, status])
  @@index([userId, createdAt])
  @@index([animeId, rating])
  @@index([episodeId])
  @@index([status])
  @@index([createdAt])
  @@index([countState, createdAt])
  @@index([userId, countState, countedAt])
  @@index([animeId, countState])
  @@index([animeId, pinnedAt])
}

// One-level replies under a review ("Reply" on the anime page). User
// content: never touched by sync/import jobs.
model ReviewReply {
  id        String    @id @default(cuid())
  reviewId  String
  userId    String
  body      String
  status    String    @default("PUBLISHED") // "PUBLISHED", "HIDDEN", "REMOVED"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt])
  @@index([userId])
}

// Tags a reviewer picked for the anime when writing their review, from the
// fixed vocabulary in src/lib/reviews/reviewTags.ts (no free text). Counted
// per anime as its "community tags". Separate from AnimeTag, which is
// provider (AniList) data.
model ReviewTag {
  reviewId  String
  animeId   String
  tag       String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  anime  Anime  @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@id([reviewId, tag])
  @@index([animeId, tag])
}

model ReviewLike {
  id           String   @id @default(cuid())
  reviewId     String
  userId       String
  reactionType String   @default("HELPFUL") // "HELPFUL", "LIKE", "DISAGREE"
  createdAt    DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
}

model ReviewReport {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  reason    String // "SPAM", "HARASSMENT", "SPOILER", "HATEFUL_CONTENT", "MISINFORMATION", "OTHER"
  details   String?
  status    String   @default("PENDING") // "PENDING", "RESOLVED", "DISMISSED"
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([status])
  @@index([reviewId])
}

// ==========================================
// WORLD 3 — COMMUNITIES & SOCIAL LAYER
// ==========================================

model Community {
  id            String    @id @default(cuid())
  ownerId       String
  name          String
  slug          String    @unique
  description   String
  iconUrl       String?
  iconSource    String?   @default("URL") // "URL", "UPLOAD"
  bannerUrl     String?
  bannerSource  String?   @default("URL") // "URL", "UPLOAD"
  category      String    @default("ANIME") // "ANIME", "GENRE", "MANGA", "REGIONAL", "INTEREST"
  communityType String    @default("GENERAL") // "ANIME", "SEASON", "GENRE", "STUDIO", "CREATOR", "GENERAL", "CREATOR_EXCLUSIVE"
  visibility    String    @default("PUBLIC") // "PUBLIC", "REQUEST_TO_JOIN", "PRIVATE"
  joinPolicy    String    @default("OPEN") // "OPEN", "APPROVAL_REQUIRED", "INVITE_ONLY", "CREATOR_ONLY"
  status        String    @default("ACTIVE") // "ACTIVE", "ARCHIVED", "DELETED"
  memberCount   Int       @default(1)
  animeId       String? // Optional relation to specific Anime
  studioId      String? // Optional relation to specific Studio
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner           User                      @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  anime           Anime?                    @relation(fields: [animeId], references: [id], onDelete: SetNull)
  studio          Studio?                   @relation(fields: [studioId], references: [id], onDelete: SetNull)
  members         CommunityMember[]
  badgeAggregates CommunityBadgeAggregate[]
  channels        CommunityChannel[]
  rules           CommunityRule[]
  discussions     Discussion[]
  joinRequests    CommunityJoinRequest[]
  bans            CommunityBan[]
  invites         CommunityInvite[]
  genres          CommunityGenre[]

  @@index([category])
  @@index([visibility])
  @@index([communityType])
  @@index([studioId])
  @@index([status])
  @@index([memberCount])
  @@index([createdAt])
}

model CommunityMember {
  id                   String    @id @default(cuid())
  communityId          String
  userId               String
  role                 String    @default("MEMBER") // "OWNER", "ADMIN", "MODERATOR", "MEMBER"
  status               String    @default("ACTIVE") // "ACTIVE", "PENDING", "BANNED", "LEFT"
  creatorVerified      Boolean   @default(false)
  verificationProvider String? // "YOUTUBE", "TWITCH", "CUSTOM"
  mutedUntil           DateTime?
  joinedAt             DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId, role])
  @@index([userId, status])
}

model CommunityRule {
  id          String @id @default(cuid())
  communityId String
  position    Int    @default(0)
  title       String
  content     String

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, position])
}

model CommunityChannel {
  id          String   @id @default(cuid())
  communityId String
  name        String
  slug        String
  type        String   @default("TEXT") // "TEXT", "ANNOUNCEMENT"
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  community   Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  discussions Discussion[]
  messages    CommunityMessage[]

  @@unique([communityId, slug])
  @@index([communityId, position])
}

model CommunityJoinRequest {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  message     String?
  status      String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId, status])
}

model CommunityBan {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  reason      String?
  createdBy   String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
}

// Members-only invitations (2026-10-24, src/lib/community/invitations.ts).
// `id` is the public part (/community/invite/<id>) and grants nothing alone;
// the access key is only ever stored as `keyHash` (SHA-256 of a 160-bit
// random key) and shown once to the owner when issued/rotated. `token` is
// the legacy column — new rows put a random opaque value there.
model CommunityInvite {
  id          String    @id @default(cuid())
  communityId String
  createdBy   String
  token       String    @unique
  keyHash     String?   @unique
  keyHint     String? // last 4 characters of the key, so the owner can tell keys apart
  expiresAt   DateTime?
  maxUses     Int?
  uses        Int       @default(0)
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([communityId, revokedAt])
}

// ==========================================
// WORLD 4 — DISCUSSIONS & MESSAGING
// ==========================================

model Discussion {
  id           String   @id @default(cuid())
  authorId     String   @default("user_default")
  animeId      String?
  episodeId    String?
  communityId  String? // null => PUBLIC DISCUSSION!
  channelId    String?
  title        String
  body         String
  type         String   @default("GENERAL") // "GENERAL", "QUESTION", "THEORY", "REACTION", "RECOMMENDATION", "ANALYSIS", "EPISODE_DISCUSSION"
  spoilerLevel String   @default("NO_SPOILER") // "NO_SPOILER", "ANIME_SPOILER", "EPISODE_SPOILER", "MANGA_SPOILER"
  status       String   @default("ACTIVE") // "ACTIVE", "PINNED", "LOCKED", "HIDDEN"
  replyCount   Int      @default(0)
  helpfulCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author    User                 @relation("DiscussionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  anime     Anime?               @relation(fields: [animeId], references: [id], onDelete: SetNull)
  episode   Episode?             @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  community Community?           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  channel   CommunityChannel?    @relation(fields: [channelId], references: [id], onDelete: SetNull)
  comments  DiscussionComment[]
  followers DiscussionFollower[]
  reactions DiscussionReaction[]
  poll      DiscussionPoll?

  @@index([animeId])
  @@index([episodeId])
  @@index([communityId])
  @@index([channelId])
  @@index([createdAt])
  @@index([helpfulCount])
}

model DiscussionPoll {
  id           String    @id @default(cuid())
  discussionId String    @unique
  question     String
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  discussion Discussion   @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  options    PollOption[]
}

model PollOption {
  id       String     @id @default(cuid())
  pollId   String
  text     String
  position Int        @default(0)
  votes    PollVote[]

  poll DiscussionPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId])
}

model PollVote {
  id        String   @id @default(cuid())
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([userId])
}

model DiscussionComment {
  id           String    @id @default(cuid())
  discussionId String
  authorId     String    @default("user_default")
  parentId     String?
  body         String
  spoilerLevel String    @default("NO_SPOILER") // "NO_SPOILER", "ANIME_SPOILER", "EPISODE_SPOILER", "MANGA_SPOILER"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  discussion Discussion          @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author     User                @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent     DiscussionComment?  @relation("ThreadedReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    DiscussionComment[] @relation("ThreadedReplies")
  reactions  CommentReaction[]
  media      CommentMedia[]

  @@index([discussionId])
  @@index([parentId])
  @@index([createdAt])
}

model DiscussionFollower {
  id           String   @id @default(cuid())
  discussionId String
  userId       String
  createdAt    DateTime @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
}

model DiscussionReaction {
  id           String   @id @default(cuid())
  discussionId String
  userId       String
  type         String   @default("HELPFUL") // "HELPFUL", "LIKE"
  createdAt    DateTime @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId, type])
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  type      String   @default("LIKE")
  createdAt DateTime @default(now())

  comment DiscussionComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, type])
}

// Image or GIF attached to a discussion comment or reply. A "meme" is an
// IMAGE. Uploads are created first with commentId = null (pending, owned by
// uploaderId) and attached when the comment is posted; the uploaded object
// itself is tracked by the linked MediaAsset. GIFs come from a provider and
// store its reference, not a copy of the file.
model CommentMedia {
  id              String    @id @default(cuid())
  commentId       String?
  uploaderId      String
  type            String // "IMAGE", "GIF"
  source          String // "UPLOAD", "GIPHY"
  providerMediaId String?
  url             String
  thumbnailUrl    String?
  width           Int?
  height          Int?
  mimeType        String?
  isSpoiler       Boolean   @default(false)
  assetId         String?
  attachedAt      DateTime?
  createdAt       DateTime  @default(now())

  comment  DiscussionComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploader User               @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  asset    MediaAsset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([commentId])
  @@index([uploaderId, commentId])
  @@index([createdAt])
}

model CommunityMessage {
  id           String    @id @default(cuid())
  channelId    String
  authorId     String    @default("user_default")
  body         String
  replyToId    String?
  spoilerLevel String    @default("NO_SPOILER")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  channel CommunityChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model Report {
  id          String    @id @default(cuid())
  reporterId  String    @default("user_default")
  targetType  String // "USER", "COMMUNITY", "DISCUSSION", "COMMENT", "MESSAGE"
  targetId    String
  reason      String // "SPAM", "HARASSMENT", "HATE", "SPOILER_MISUSE", "PIRACY", "OTHER"
  description String?
  status      String    @default("OPEN") // "OPEN", "REVIEWED", "DISMISSED", "ACTIONED"
  actionTaken String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  reporter User @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetType, targetId])
}

model ModerationAction {
  id           String   @id @default(cuid())
  moderatorId  String
  targetUserId String?
  communityId  String?
  targetType   String
  targetId     String
  action       String // "WARN", "DELETE", "HIDE", "TIMEOUT", "BAN", "UNBAN", "LOCK"
  reason       String?
  createdAt    DateTime @default(now())

  moderator User @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([targetUserId])
}

model UserList {
  id          String   @id @default(cuid())
  userId      String   @default("user_default")
  name        String
  description String?
  visibility  String   @default("PUBLIC") // "PUBLIC", "PRIVATE", "LINK" (anyone with the share link), "FOLLOWERS_ONLY"
  /// Random token for the share URL (/l/<token>); set when the owner shares the list. Never the list id.
  shareToken  String?  @unique
  /// Collection banner (2026-10-22): the owner's uploaded image or one of its anime's AniList banners. Null = derived from its anime.
  bannerUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items UserListItem[]

  @@index([userId])
  @@index([visibility, updatedAt])
}

model UserListItem {
  id       String   @id @default(cuid())
  listId   String
  animeId  String
  position Int      @default(0)
  notes    String?
  addedAt  DateTime @default(now())

  list  UserList @relation(fields: [listId], references: [id], onDelete: Cascade)
  anime Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([listId, animeId])
  @@index([listId])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String   @default("user_default")
  type      String // "ADDED_TO_LIBRARY", "STATUS_CHANGED", "EPISODE_WATCHED", "ANIME_COMPLETED", "ANIME_RATED", "REVIEW_CREATED", "LIST_CREATED", "ANIME_FAVORITED", "JOINED_COMMUNITY", "DISCUSSION_CREATED"
  animeId   String?
  metadata  String? // JSON string
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @default("user_default")
  // Free-form, not a DB-enforced enum — this comment is the only source
  // of truth for valid values, and it had drifted from what the code
  // actually emits (checked 2026-09-16: it listed REPLY_REVIEW/
  // COMMUNITY_INVITE/MODERATION_ACTION, none of which any code path
  // creates, and was missing several types real code did emit). Kept
  // current here on purpose since there's no other enum to check against.
  // Emitted today: "REPLY_COMMENT" (reply to a discussion comment),
  // "REPLY_DISCUSSION" (reply to someone's discussion post), "MENTION"
  // (@username in a discussion/comment), "COMMUNITY_JOIN_REQUEST"/
  // "BADGE_TIER_EARNED"/"BADGE_TIER_CHANGED" (reviewer-badge tier went up /
  // down, src/lib/badges/countingService.ts), "REVIEW_HELPFUL" (a review
  // of yours reached a helpful-vote milestone), "CRITIC_PICK" (a review of
  // yours was picked for the critic's section),
  // "COMMUNITY_JOIN_APPROVED"/"COMMUNITY_JOIN_REJECTED" (community join
  // request lifecycle), "COMMUNITY_NEW_DISCUSSION" (new post in a
  // community you're an active member of), "NEW_EPISODE" (a new episode
  // aired for an anime in your library as WATCHING/PLAN_TO_WATCH),
  // "NEW_FOLLOWER" (someone followed you), "REPLY_REVIEW" (someone replied
  // to your anime review, src/lib/reviews/reviewSocial.ts),
  // "FOLLOWING_REVIEW"/"FOLLOWING_ARTICLE"/"FOLLOWING_COLLECTION"/
  // "FOLLOWING_COMMUNITY" (someone you follow reviewed / posted an article /
  // published a public collection / was active in a public thread —
  // src/lib/social/followService.ts). See src/lib/engine/community/
  // commentService.ts, communityEngine.ts, src/lib/catalog/
  // episodeIngest.ts, and src/app/api/users/[username]/follow/route.ts
  // for the actual call sites — grep `prisma.notification.create` across
  // src/ before trusting this list blindly, the same way this comment's
  // predecessor should have been checked before being trusted.
  type      String
  title     String
  body      String?
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ==========================================
// CANONICAL DATA ENGINE & PROVENANCE MODELS
// ==========================================

model ContentWarning {
  id             String    @id @default(cuid())
  animeId        String
  type           String // Violence, Gore, Sexual Content, Strong Language, Self Harm Themes, etc.
  severity       String? // MILD, MODERATE, SEVERE
  source         String    @default("anilist")
  provider       String    @default("anilist")
  lastVerifiedAt DateTime? @default(now())
  createdAt      DateTime  @default(now())

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([animeId])
  @@index([type])
}

model MediaAsset {
  id             String    @id @default(cuid())
  userId         String?
  animeId        String?
  type           String // AVATAR, BANNER, POSTER, COVER, THUMBNAIL, TRAILER, PROMOTIONAL_IMAGE
  source         String // r2, anilist, jikan, local
  sourceUrl      String
  storedUrl      String?
  storageKey     String?
  width          Int?
  height         Int?
  size           Int?
  mimeType       String?
  format         String? // webp, jpg, png
  lastVerifiedAt DateTime? @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime        Anime?         @relation(fields: [animeId], references: [id], onDelete: Cascade)
  commentMedia CommentMedia[]

  @@index([userId])
  @@index([animeId])
  @@index([type])
}

model AnimeExternalLink {
  id        String   @id @default(cuid())
  animeId   String
  provider  String // AniList, MyAnimeList, Official Website, Streaming Service, Wikipedia
  url       String
  type      String? // STREAMING, OFFICIAL, INFO, SOCIAL
  createdAt DateTime @default(now())

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([animeId])
}

model DeadLetterQueue {
  id            String    @id @default(cuid())
  provider      String
  entityType    String
  externalId    String
  error         String
  attempts      Int       @default(1)
  lastAttemptAt DateTime  @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([provider, entityType])
}

model PotentialDuplicate {
  id               String    @id @default(cuid())
  primaryAnimeId   String
  secondaryAnimeId String?
  provider         String
  externalId       String
  similarityScore  Float
  reason           String
  status           String    @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?

  @@index([primaryAnimeId])
  @@index([status])
}

model ProviderPayload {
  id          String   @id @default(cuid())
  provider    String // "anilist", "jikan"
  entityType  String // "anime", "character", "staff", "episode"
  externalId  String
  payload     String // Raw JSON string
  hash        String?
  retrievedAt DateTime @default(now())

  @@unique([provider, entityType, externalId])
  @@index([provider, entityType])
}

// ==========================================
// WORLD 5 — NEWS & INDUSTRY AGGREGATION
// ==========================================

model NewsProvider {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  baseUrl            String
  domain             String?
  feedUrl            String?
  sourceType         String    @default("NEWS_PUBLICATION") // "OFFICIAL", "NEWS_PUBLICATION", "STUDIO", "CREATOR", "ORGANIZER", "LOCAL_MEDIA"
  trustLevel         String    @default("HIGH") // "HIGH", "MEDIUM", "LOW"
  language           String    @default("en")
  country            String?
  active             Boolean   @default(true)
  status             String    @default("HEALTHY") // "HEALTHY", "DEGRADED", "FAILED", "DISABLED"
  lastSuccessfulSync DateTime?
  lastFailedSync     DateTime?
  failureCount       Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model NewsStoryCluster {
  id           String    @id @default(cuid())
  canonicalKey String?   @unique
  topicTitle   String
  slug         String    @unique
  summary      String?
  eventType    String? // "SEASON_ANNOUNCEMENT", "RELEASE_DATE", "TRAILER", "CAST_ANNOUNCEMENT", "STAFF_ANNOUNCEMENT", "DELAY_OR_HIATUS", "BOX_OFFICE", "LICENSING", "EVENT"
  occurredAt   DateTime?
  createdAt    DateTime  @default(now())

  articles NewsArticle[]
}

model NewsArticle {
  id                    String    @id @default(cuid())
  title                 String
  subtitle              String?
  slug                  String    @unique
  summary               String?
  content               String?
  contentType           String    @default("SOURCE_METADATA") // "SOURCE_METADATA", "OTAKUVA_SUMMARY", "LICENSED_CONTENT", "USER_GENERATED_CONTENT"
  sourceName            String // "Anime News Network", "Crunchyroll News", "Official Press"
  sourceUrl             String
  canonicalUrl          String?
  imageUrl              String?
  author                String?
  language              String    @default("en")
  country               String?
  category              String    @default("ANIME") // "ANIME", "MANGA", "STUDIOS", "INDUSTRY", "ANNOUNCEMENTS", "CASTING", "PRODUCTION", "TRAILERS"
  // Anime-relevance gate. Sources like ANN and Anime Corner cover general
  // Japanese gaming and entertainment alongside anime, so being in the feed
  // is not by itself evidence an article is anime-related.
  //   "ANIME_RELATED" — shown in the public feed (default)
  //   "REVIEW"        — still shown, but flagged for an editor to confirm
  //   "OFF_TOPIC"     — withheld from the public feed, never deleted
  // Off-topic articles are retained so a misclassification is reversible and
  // auditable (rule 6, section 77). relevanceReason records which signals fired.
  relevance             String    @default("ANIME_RELATED")
  relevanceScore        Float     @default(1.0)
  relevanceReason       String?
  status                String    @default("PUBLISHED") // "DRAFT", "PUBLISHED", "SCHEDULED", "ARCHIVED", "REMOVED", "FAILED", "PUBLISH_BLOCKED"
  verificationStatus    String    @default("VERIFIED") // "UNVERIFIED", "VERIFIED", "DISPUTED", "CORRECTED", "RETRACTED"
  moderationState       String    @default("APPROVED") // "PENDING_REVIEW", "APPROVED", "REJECTED", "PUBLISH_BLOCKED"
  isFeatured            Boolean   @default(false)
  featuredPriority      Int       @default(0)
  featuredUntil         DateTime?
  scheduledPublishAt    DateTime?
  deletedAt             DateTime?
  publishedAt           DateTime  @default(now())
  discoveredAt          DateTime  @default(now())
  provider              String    @default("ANN")
  externalId            String?
  contentHash           String?
  ingestedAt            DateTime  @default(now())
  lastSyncedAt          DateTime  @default(now())
  clusterId             String?
  adminOverrideTitle    String?
  adminOverrideSummary  String?
  adminOverrideCategory String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  cluster          NewsStoryCluster?   @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  animeRelations   NewsArticleAnime[]
  studioRelations  NewsArticleStudio[]
  personRelations  NewsArticlePerson[]
  reviewQueueItems NewsReviewQueue[]

  @@unique([provider, externalId])
  @@index([publishedAt])
  @@index([category])
  @@index([relevance])
  @@index([sourceName])
  @@index([provider])
  @@index([status])
  @@index([isFeatured])
  @@index([scheduledPublishAt])
  @@index([clusterId])
}

model NewsArticleAnime {
  articleId       String
  animeId         String
  confidenceScore Float    @default(1.0)
  matchMethod     String   @default("EXACT_TITLE") // "EXACT_TITLE", "ALIAS", "NORMALIZED", "MANUAL"
  status          String   @default("CONFIRMED") // "CONFIRMED", "REVIEW_REQUIRED", "REJECTED"
  relationType    String   @default("RELATED") // "PRIMARY", "RELATED", "MENTIONED"
  createdAt       DateTime @default(now())

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  anime   Anime       @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@id([articleId, animeId])
  @@index([animeId])
  @@index([status])
}

model NewsArticleStudio {
  articleId       String
  studioId        String
  confidenceScore Float    @default(1.0)
  matchMethod     String   @default("EXACT_NAME") // "EXACT_NAME", "ALIAS", "NORMALIZED", "MANUAL"
  status          String   @default("CONFIRMED") // "CONFIRMED", "REVIEW_REQUIRED", "REJECTED"
  relationType    String   @default("PRODUCED_BY") // "PRODUCED_BY", "RELATED", "MENTIONED"
  createdAt       DateTime @default(now())

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  studio  Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@id([articleId, studioId])
  @@index([studioId])
  @@index([status])
}

model NewsArticlePerson {
  articleId String
  personId  String
  createdAt DateTime @default(now())

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  person  Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([articleId, personId])
  @@index([personId])
}

model NewsReviewQueue {
  id              String    @id @default(cuid())
  articleId       String
  entityType      String // "ANIME", "STUDIO", "PERSON"
  entityName      String
  matchedEntityId String?
  confidenceScore Float
  status          String    @default("PENDING") // "PENDING", "APPROVED", "DISMISSED"
  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([articleId])
}

model NewsIngestionJob {
  id              String    @id @default(cuid())
  providerSlug    String
  status          String    @default("RUNNING") // "QUEUED", "RUNNING", "COMPLETED", "PARTIAL", "FAILED", "CANCELLED"
  articlesFetched Int       @default(0)
  articlesCreated Int       @default(0)
  articlesUpdated Int       @default(0)
  duplicatesCount Int       @default(0)
  matchesCreated  Int       @default(0)
  reviewRequired  Int       @default(0)
  failedCount     Int       @default(0)
  errorSummary    String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([providerSlug, status])
  @@index([startedAt])
}

// ==========================================
// WORLD 6 — REAL-TIME MESSAGING & CHAT
// ==========================================

model Conversation {
  id          String   @id @default(cuid())
  type        String   @default("DIRECT") // "DIRECT", "GROUP", "ANIME_ROOM"
  title       String?
  avatarUrl   String?
  animeId     String? // set only for type = "ANIME_ROOM": one persistent live room per anime
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  anime        Anime?                    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@unique([animeId])
  @@index([type])
  @@index([updatedAt])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  role           String    @default("MEMBER") // "ADMIN", "MEMBER"
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())
  isMuted        Boolean   @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  messageType    String    @default("TEXT") // "TEXT", "IMAGE", "GIF", "MEME", "SYSTEM"
  mediaUrl       String?
  replyToId      String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions    MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ==========================================
// WORLD 7 — OTAKUVA ENGINE & INTELLIGENCE
// ==========================================

model ReviewAspect {
  id             String   @id @default(cuid())
  reviewId       String
  aspect         String // "STORY", "ANIMATION", "CHARACTERS", "MUSIC", "DIRECTION", "PACING", "WORLD_BUILDING", "ENJOYMENT"
  sentiment      String // "POSITIVE", "MIXED", "NEGATIVE"
  sentimentScore Float // -1.0 to 1.0
  confidence     Float    @default(1.0)
  snippetsJson   String? // JSON array of supporting quote snippets
  createdAt      DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([aspect, sentiment])
}

model AnimeCommunityOpinion {
  id                       String   @id @default(cuid())
  animeId                  String   @unique
  overallSentiment         String   @default("POSITIVE") // "POSITIVE", "MIXED", "NEGATIVE"
  storyScore               Float?
  animationScore           Float?
  charactersScore          Float?
  musicScore               Float?
  directionScore           Float?
  pacingScore              Float?
  worldBuildingScore       Float?
  enjoymentScore           Float?
  positivePercentage       Float    @default(0.0)
  mixedPercentage          Float    @default(0.0)
  negativePercentage       Float    @default(0.0)
  frequentlyPraisedJson    String? // JSON array of strings
  frequentlyCriticizedJson String? // JSON array of strings
  analyzedReviewCount      Int      @default(0)
  confidence               String   @default("NO_DATA")
  updatedAt                DateTime @updatedAt

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([overallSentiment])
}

model EventLog {
  id         String   @id @default(cuid())
  eventType  String // "ANIME_BOOKMARKED", "EPISODE_COMPLETED", "ANIME_COMPLETED", "EPISODE_RATED", "ANIME_RATED", "REVIEW_CREATED", "COMMUNITY_CREATED", "COMMUNITY_JOINED", "POST_CREATED", "COMMENT_CREATED", "MESSAGE_SENT"
  userId     String?
  entityType String // "ANIME", "EPISODE", "COMMUNITY", "REVIEW", "DISCUSSION", "MESSAGE"
  entityId   String
  metadata   String? // JSON serialized context
  version    Int      @default(1)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([entityType, entityId])
}

model AnimeTrendMetric {
  id                  String   @id @default(cuid())
  animeId             String   @unique
  interactionVolume   Int      @default(0)
  interactionVelocity Float    @default(0.0)
  growthRatePercent   Float    @default(0.0)
  momentumScore       Float    @default(0.0)
  trendTier           String   @default("POPULAR") // "POPULAR", "TRENDING", "RISING"
  timeDecayScore      Float    @default(0.0)
  updatedAt           DateTime @updatedAt

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([momentumScore])
  @@index([trendTier])
}

model StreamingAvailability {
  id               String    @id @default(cuid())
  animeId          String
  provider         String // "Crunchyroll", "Netflix", "Hulu", "HIDIVE", "Disney+", "Amazon Prime"
  region           String    @default("GLOBAL") // "GLOBAL", "US", "JP", "EU", "LATAM", etc.
  availabilityType String    @default("SUBSCRIPTION") // "SUBSCRIPTION", "FREE_WITH_ADS", "PURCHASE"
  url              String?
  source           String    @default("OFFICIAL")
  lastVerifiedAt   DateTime? @default(now())
  createdAt        DateTime  @default(now())

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([animeId, region])
  @@index([provider])
}

/// Official icon + brand colour for a streaming site (from AniList's
/// external-link sources). Keyed by the site name used in
/// StreamingAvailability.provider. (2026-10-26)
model StreamingPlatform {
  id            String   @id @default(cuid())
  site          String   @unique
  anilistSiteId Int?
  iconUrl       String?
  color         String?
  source        String   @default("anilist")
  fetchedAt     DateTime @default(now())
}

model UserTasteProfile {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  profileVersion             Int      @default(1)
  confidenceTier             String   @default("NEW_USER") // "NEW_USER", "LOW_CONFIDENCE", "LEARNING", "ESTABLISHED"
  overallConfidence          Float    @default(0.0)
  totalSignalsCount          Int      @default(0)
  topGenresJson              String? // JSON array of strings
  topThemesJson              String? // JSON array of strings
  topStudiosJson             String? // JSON array of strings
  aspectProfileJson          String? // JSON object of aspect scores
  shortTermProfileJson       String? // JSON object of 30-day window preferences
  formatPreferencesJson      String? // JSON object of format preferences (TV, Movie, OVA, etc.)
  lengthPreferencesJson      String? // JSON object of length preferences (Short, Medium, Long)
  seasonalityPreferencesJson String? // JSON object of seasonality preferences (Current, Classic)
  creatorPreferencesJson     String? // JSON object of director/creator affinities
  derivedExplanationsJson    String? // JSON array of human-readable insights
  updatedAt                  DateTime @updatedAt
  createdAt                  DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  signals UserTasteSignal[]

  @@index([userId])
  @@index([confidenceTier])
}

model UserTasteSignal {
  id              String   @id @default(cuid())
  profileId       String
  signalType      String // "GENRE", "THEME", "STUDIO", "PRODUCER", "ASPECT", "FORMAT", "LENGTH", "CREATOR"
  targetName      String // e.g. "Psychological", "Madhouse", "STORY", "TV", "SHORT"
  preferenceScore Float // -1.0 to 1.0 bounded normalized score
  confidenceScore Float    @default(0.0)
  evidenceCount   Int      @default(1)
  evidenceJson    String? // JSON metadata e.g. { ratingCount: 5, avgRating: 9.2, completionCount: 4 }
  lastUpdated     DateTime @default(now())

  profile UserTasteProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, signalType, targetName])
  @@index([profileId, signalType])
  @@index([preferenceScore])
}

model RecommendationSession {
  id               String               @id @default(cuid())
  userId           String
  algorithmVersion Int                  @default(1)
  context          String               @default("HOME") // "HOME", "ANIME_PAGE", "EXPLORE", "FOR_YOU"
  targetAnimeId    String? // Contextual target anime if context is ANIME_PAGE
  items            RecommendationItem[]
  createdAt        DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([context])
}

model RecommendationItem {
  id         String   @id @default(cuid())
  sessionId  String
  animeId    String
  position   Int
  score      Float
  source     String // "TASTE", "CONTENT", "SIMILAR", "POPULAR", "TRENDING", "EXPLORATION", "COMMUNITY", "NEWS", "SEASONAL", "CREATOR", "THEME", "STUDIO"
  reasonType String // "TASTE_GENRE", "TASTE_STUDIO", "TASTE_ASPECT", "SIMILAR_ANIME", "POPULAR", "EXPLORATION", "COMMUNITY", "NEWS", "CREATOR"
  reasonText String
  reasonData String? // JSON metadata
  status     String   @default("DELIVERED") // "DELIVERED", "CLICKED", "DISMISSED", "SAVED"
  createdAt  DateTime @default(now())

  session RecommendationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  anime   Anime                 @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([sessionId, position])
  @@index([animeId])
}

model RecommendationFeedback {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  feedback  String // "MORE_LIKE_THIS", "LESS_LIKE_THIS", "NOT_INTERESTED", "DISMISSED", "CLICKED", "WATCH_STARTED", "COMPLETED"
  context   String?  @default("HOME")
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId, feedback])
  @@index([userId, feedback])
  @@index([animeId])
}

// ==========================================
// WORLD 8 — ADVANCED AI / ML INTELLIGENCE LAYER
// ==========================================

model EntityEmbedding {
  id             String   @id @default(cuid())
  entityId       String
  entityType     String // "ANIME", "CHARACTER", "STUDIO", "PERSON", "REVIEW", "COMMUNITY", "USER_TASTE"
  modelName      String   @default("otakuva-semantic-v1")
  modelVersion   String   @default("v1")
  dimension      Int      @default(64)
  vectorJson     String // JSON serialized array of floats e.g. [0.12, -0.45, ...]
  documentDigest String? // Deterministic hash of source semantic document
  status         String   @default("ACTIVE") // "ACTIVE", "STALE", "FAILED", "DELETED"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([entityType, entityId, modelVersion])
  @@index([entityType, entityId])
  @@index([status])
  @@index([modelName, modelVersion])
}

model ReviewAnalysis {
  id               String   @id @default(cuid())
  reviewId         String   @unique
  language         String   @default("en")
  overallSentiment String // "POSITIVE", "NEGATIVE", "NEUTRAL", "MIXED"
  sentimentScore   Float // -1.0 to 1.0
  confidence       Float    @default(1.0)
  aspectsJson      String // JSON array of extracted aspects with sentiment & confidence
  topicsJson       String? // JSON array of key topic keywords
  summaryText      String? // AI-derived analytical summary
  analysisModel    String   @default("review-aspect-v1")
  analysisVersion  String   @default("v1")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([overallSentiment])
  @@index([analysisVersion])
}

model UserInterestCluster {
  id           String   @id @default(cuid())
  userId       String
  clusterIndex Int // 0, 1, 2...
  clusterLabel String // e.g. "Psychological Mystery", "Slice of Life Comedy"
  weight       Float    @default(1.0)
  genresJson   String // JSON array of genres
  themesJson   String // JSON array of themes
  vectorJson   String? // Centroid vector snapshot
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ModelRegistry {
  id                String    @id @default(cuid())
  modelName         String // e.g. "hybrid-ranking-model", "start-probability-predictor"
  modelVersion      String // e.g. "v1.0", "v1.1"
  taskType          String // "RANKING", "PREDICTION", "EMBEDDING", "REVIEW_ASPECT"
  status            String    @default("READY") // "TRAINING", "VALIDATING", "READY", "PRODUCTION", "ARCHIVED", "FAILED"
  featureVersion    String    @default("v1")
  metricsJson       String? // JSON metrics: precision, recall, ndcg, auc, latency
  configJson        String? // JSON hyperparams / weights
  trafficPercentage Int       @default(0) // For canary / A/B testing: 0 to 100
  deployedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([modelName, modelVersion])
  @@index([taskType, status])
}

model RecommendationPrediction {
  id                   String   @id @default(cuid())
  userId               String
  animeId              String
  predictionType       String // "START_PROBABILITY", "COMPLETION_PROBABILITY", "RATING_PROBABILITY"
  predictedProbability Float // 0.0 to 1.0
  modelVersion         String
  featuresJson         String? // Snapshot of feature values at prediction time
  outcomeRecorded      String? // "CLICKED", "STARTED", "COMPLETED", "DISMISSED", "NONE"
  createdAt            DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([userId, animeId])
  @@index([predictionType])
}

// ==========================================
// REVIEWER BADGES (src/lib/badges)
// ==========================================

// One row per user who has ever been evaluated by the counting job.
// currentTier is a cache of tierFor(countedReviewCount) plus the quality
// gates in src/lib/badges/config.ts — it is what pages read, never recomputed
// on render.
model UserBadgeStats {
  userId              String    @id
  countedReviewCount  Int       @default(0)
  currentTier         String    @default("shoshinsha")
  helpfulVotes        Int       @default(0)
  lastCountedReviewAt DateTime?
  hasConfirmedSpam    Boolean   @default(false)
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentTier])
}

// Specialty / seasonal badges (future). Volume tiers are NOT stored here.
model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeKey String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey])
  @@index([badgeKey])
}

// "Tier earned" / milestone events. Drive the unlock toast; the matching
// Notification row is created in the same transaction. seenAt is set once the
// client has shown the toast. dedupeKey is set for milestones (fire once ever);
// null for tier events, which are made exactly-once by the guarded tier update.
model BadgeEvent {
  id        String    @id @default(cuid())
  userId    String
  type      String // "TIER_EARNED", "TIER_LOST", "MILESTONE"
  tierKey   String?
  count     Int       @default(0)
  dedupeKey String?
  seenAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, seenAt])
}

// Cached: counted reviews on an anime, by the reviewer's CURRENT tier.
model AnimeBadgeAggregate {
  animeId String
  tierKey String
  count   Int    @default(0)

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@id([animeId, tierKey])
}

// Cached: active members of a community, by member tier.
model CommunityBadgeAggregate {
  communityId String
  tierKey     String
  count       Int    @default(0)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([communityId, tierKey])
}

// Member-written articles (2026-10-16): news tips, write-ups and information
// about an anime that a user shares with everyone. Deliberately separate from
// NewsArticle — that table is provider-ingested editorial news with its own
// moderation pipeline; these are community content, shown only in the
// Articles section and on the author's profile, never in News.
model UserArticle {
  id            String    @id @default(cuid())
  slug          String    @unique
  authorId      String
  title         String
  summary       String?
  body          String
  coverImageUrl String?
  coverAssetId  String?
  // [{ "label": "Official site", "url": "https://…" }], max 5, http(s) only
  links         Json      @default("[]")
  animeId       String?
  // PUBLISHED | HIDDEN (moderator) | REMOVED (author deleted). Only PUBLISHED is ever listed.
  status        String    @default("PUBLISHED")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  author   User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  anime    Anime?               @relation(fields: [animeId], references: [id], onDelete: SetNull)
  likes    UserArticleLike[]
  comments UserArticleComment[]

  @@index([status, createdAt])
  @@index([authorId, createdAt])
  @@index([animeId])
}

// Member article likes (2026-10-18): one per person per article.
model UserArticleLike {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  createdAt DateTime @default(now())

  article UserArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([articleId])
}

// Member article comments (2026-10-18). Plain text. Author delete =
// deletedAt; moderator hide = status HIDDEN. Only PUBLISHED + not deleted is shown.
// Replies (2026-10-19): parentId points at a top-level comment — threads are
// one level deep, like YouTube; replying to a reply attaches to its parent.
model UserArticleComment {
  id        String    @id @default(cuid())
  articleId String
  userId    String
  parentId  String?
  body      String
  status    String    @default("PUBLISHED")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  article UserArticle              @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  UserArticleComment?      @relation("ArticleCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies UserArticleComment[]     @relation("ArticleCommentReplies")
  likes   UserArticleCommentLike[]

  @@index([articleId, createdAt])
  @@index([parentId])
  @@index([userId])
}

// One like per person per article comment (2026-10-19).
model UserArticleCommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment UserArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
}

// Genres a community is about (2026-10-19), picked by its owner. Lets an
// anime page suggest communities for its genres without matching on names.
model CommunityGenre {
  communityId String
  genreId     String

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  genre     Genre     @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([communityId, genreId])
  @@index([genreId])
}

/// Pre-premiere anticipation (2026-10-20): one vote per member per anime,
/// only until episode 1 airs. Never feeds the OTAKUVA Score.
model AnimeHype {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  level     String // "HYPED" | "EXCITED" | "CURIOUS" | "SKIP"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([animeId, level])
}

/// "What's your vibe about this anime?" (2026-10-25): one grade per member,
/// per anime, per aspect (Story, Characters … — ACTIVE_RATING_CATEGORIES).
/// Grades only (WORST / AVERAGE / DECENT / GOOD / GREAT), no 1–10 needed.
/// Feeds the OTAKUVA Vibe chart together with older aspect scores given in
/// the 1–10 rating window (src/lib/rating/vibe.ts).
model AnimeVibe {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  category  String // STORY | CHARACTERS | ANIMATION | MUSIC | PACING | WORLD_BUILDING | ENJOYMENT
  grade     String // WORST | AVERAGE | DECENT | GOOD | GREAT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId, category])
  @@index([animeId])
}

// Control center (2026-10-28): owner-made ranked lists — "Top 10 …",
// "Top 100 …", and the OTAKUVA Choice list itself (slug "otakuva-choice",
// which replaces the hand-edited src/lib/curated.ts list once it has entries).
// Published charts show at /charts/<slug>. Read/written with plain SQL in
// "Control Center/lib/charts.ts" (newer than some running Prisma clients).
model CuratedChart {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  size        Int      @default(10)
  isPublished Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  entries CuratedChartEntry[]
}

model CuratedChartEntry {
  id        String   @id @default(cuid())
  chartId   String
  animeId   String
  position  Int
  note      String?
  createdAt DateTime @default(now())

  chart CuratedChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  anime Anime        @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([chartId, animeId])
  @@index([chartId, position])
}

// The homepage's OTAKUVA Choice spotlight for one (UTC) day, chosen in the
// control center. Days without a row fall back to the daily rotation.
model DailyPick {
  id          String   @id @default(cuid())
  day         DateTime @unique @db.Date
  animeId     String
  headline    String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
}

// Page views per page per day (control center analytics, 2026-10-28). Counts
// only — no user id, IP or cookie. Written by POST /api/track/view (plain SQL).
model PageViewDaily {
  kind     String // "anime" | "news" | "article" | "collection" | "chart" | "studio" | "person"
  entityId String
  day      DateTime @db.Date
  views    Int      @default(0)

  @@id([kind, entityId, day])
  @@index([kind, day])
}

model SponsorAd {
  id          String   @id @default(cuid())
  title       String?
  imageUrl    String?
  videoUrl    String?
  clickUrl    String?
  altText     String?
  placement   String   @default("HOME_ABOVE_HYPE")
  enabled     Boolean  @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  @@index([enabled, placement, startsAt, endsAt])
}

model CommissionProduct {
  id          String   @id @default(cuid())
  /// null = in the shared pool (rotated across every anime page); set = pinned to that anime
  animeId     String?
  title       String?
  merchant    String?
  url         String?
  imageUrl    String?
  videoUrl    String?
  price       String?
  disclosure  String?  @default("As an affiliate, OTAKUVA may earn from qualifying purchases.")
  position    Int      @default(0)
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  anime Anime? @relation(fields: [animeId], references: [id], onDelete: Cascade)
  @@index([animeId, enabled, position])
  @@index([enabled, position])
}

model MonetizationSetting {
  id                 String   @id @default("main")
  sponsorAdsEnabled  Boolean  @default(false)
  commissionsEnabled Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}
