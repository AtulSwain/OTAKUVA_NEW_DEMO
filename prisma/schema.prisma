datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// WORLD 1 — ANIME CATALOG DATA MODELS
// ==========================================

model Anime {
  id             String  @id @default(cuid())
  externalSource String  @default("anilist") // "anilist" (primary) or "mal"
  externalId     String?
  malId          Int?
  anilistId      Int?
  slug           String  @unique

  canonicalTitle String
  synopsis       String
  background     String?

  type    String  @default("TV") // TV, MOVIE, OVA, ONA, SPECIAL, MUSIC, TV_SPECIAL, OTHER, UNKNOWN
  source  String? // MANGA, LIGHT_NOVEL, ORIGINAL, etc.
  status  String  @default("Finished") // NOT_YET_AIRED, AIRING, FINISHED, CANCELLED, HIATUS, UNKNOWN
  country String? @default("JP")
  isAdult Boolean @default(false)

  episodes Int?
  duration String?
  rating   String?

  // Date representation with exact precision tracking
  airedFrom     DateTime?
  airedTo       DateTime?
  startDate     DateTime?
  endDate       DateTime?
  startYear     Int?
  startMonth    Int?
  startDay      Int?
  endYear       Int?
  endMonth      Int?
  endDay        Int?
  datePrecision String    @default("UNKNOWN") // "YEAR", "MONTH", "DAY", "UNKNOWN"

  season     String?
  seasonYear Int?
  year       Int?

  broadcastDay      String?
  broadcastTime     String?
  broadcastTimezone String?

  nextAiringEpisode Int?
  nextAiringAt      DateTime?
  timeUntilAiring   Int?

  score          Float?
  scoredBy       Int?   @default(0)
  rank           Int?
  popularity     Int?
  members        Int?   @default(0)
  favoritesCount Int?   @default(0)

  posterUrl      String
  largePosterUrl String?
  bannerUrl      String?
  trailerUrl     String?

  metadataHash          String?
  dataCompletenessScore Float?  @default(0.0)

  firstImportedAt DateTime @default(now())
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relational Entities
  externalIds         AnimeExternalId[]
  titles              AnimeTitle[]
  seasons             Season[]
  episodesList        Episode[]
  animeGenres         AnimeGenre[]
  animeThemes         AnimeTheme[]
  animeTags           AnimeTag[]
  animeStudios        AnimeStudio[]
  animeProducers      AnimeProducer[]
  animeLicensors      AnimeLicensor[]
  characters          AnimeCharacter[]
  staff               AnimeStaff[]
  relationsFrom       AnimeRelation[]        @relation("SourceAnime")
  relationsTo         AnimeRelation[]        @relation("TargetAnime")
  franchiseItems      FranchiseAnime[]
  videos              AnimeVideo[]
  airingSchedules     AiringSchedule[]
  externalStats       ExternalAnimeStats?
  conflicts           DataConflict[]
  history             AnimeMetadataHistory[]
  contentWarnings     ContentWarning[]
  mediaAssets         MediaAsset[]
  externalLinks       AnimeExternalLink[]
  newsRelations       NewsArticleAnime[]
  studioHistoryEvents StudioHistoryEvent[]

  // World 2 & 3 Relationships
  userAnimes                UserAnime[]
  userEpisodeProgress       UserEpisodeProgress[]
  episodeWatches            UserEpisodeWatch[]
  ratings                   AnimeRating[]
  ratingAggregate           RatingAggregate?
  episodeRatings            EpisodeRating[]
  ratingCategoryAggregates  RatingCategoryAggregate[]
  ratingEvents              RatingEvent[]
  ratingRiskSignals         RatingRiskSignal[]
  favorites                 Favorite[]
  reviews                   Review[]
  reviewTags                ReviewTag[]
  badgeAggregates           AnimeBadgeAggregate[]
  discussions               Discussion[]
  communities               Community[]
  listItems                 UserListItem[]
  communityOpinion          AnimeCommunityOpinion?
  trendMetric               AnimeTrendMetric?
  streamingAvailability     StreamingAvailability[]
  userArticles              UserArticle[]
  recommendationItems       RecommendationItem[]
  recommendationFeedback    RecommendationFeedback[]
  recommendationPredictions RecommendationPrediction[]
  chatRoomConversation      Conversation[]

  hypes AnimeHype[]
  vibes AnimeVibe[]

  @@unique([externalSource, externalId])
  @@index([year, season])
  @@index([score])
  @@index([popularity])
  @@index([malId])
  @@index([anilistId])
  @@index([startYear])
  @@index([status])
  @@index([type])
  // Control center (2026-10-28)
  chartEntries CuratedChartEntry[]
  dailyPicks   DailyPick[]
  commissionProducts CommissionProduct[]
}

model AnimeExternalId {
  id         String   @id @default(cuid())
  animeId    String
  provider   String // "anilist", "mal", "kitsu", "crunchyroll"
  externalId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([animeId])
  @@index([provider, externalId])
}

model AnimeTitle {
  id              String  @id @default(cuid())
  animeId         String
  type            String // "official", "english", "japanese", "romaji", "synonym", "alternative"
  title           String
  language        String? // ISO language code (e.g. "en", "ja", "ro")
  isPrimary       Boolean @default(false)
  searchableTitle String? // normalized title for search indexing

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([animeId])
  @@index([title])
  @@index([searchableTitle])
}

model Season {
  id           String    @id @default(cuid())
  animeId      String
  seasonNumber Int       @default(1)
  title        String // e.g. "Season 1", "Entertainment District Arc", "Specials"
  slug         String?
  description  String?
  coverImage   String?
  year         Int?
  seasonType   String    @default("MAIN") // "MAIN", "SPECIAL", "OVA", "ONA", "MOVIE", "RECAP"
  startDate    DateTime?
  endDate      DateTime?
  episodeCount Int?      @default(0)
  sortOrder    Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  anime           Anime            @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episodes        Episode[]
  airingSchedules AiringSchedule[]

  @@unique([animeId, seasonNumber])
  @@index([animeId, sortOrder])
}

model Episode {
  id                    String    @id @default(cuid())
  animeId               String
  seasonId              String?
  externalId            String?
  number                Float     @default(1.0) // Float to safely support decimals e.g. 0.5, 12.5
  absoluteEpisodeNumber Float?
  canonicalOrder        Int?
  title                 String?
  titleJapanese         String?
  synopsis              String?
  airedAt               DateTime?
  duration              String?
  filler                Boolean   @default(false)
  recap                 Boolean   @default(false)
  status                String    @default("RELEASED") // "UPCOMING", "RELEASED", "AIRING", "DELAYED", "CANCELLED"
  imageUrl              String?
  externalUrl           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  anime  Anime   @relation(fields: [animeId], references: [id], onDelete: Cascade)
  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  externalSources EpisodeExternalSource[]
  userProgress    UserEpisodeProgress[]
  episodeRatings  EpisodeRating[]
  discussions     Discussion[]
  reviews         Review[]
  scheduleEntries AiringSchedule[]

  @@unique([animeId, number])
  @@index([animeId])
  @@index([seasonId])
}

model EpisodeExternalSource {
  id                    String   @id @default(cuid())
  episodeId             String
  provider              String // "jikan", "anilist", "mal", "kitsu"
  externalId            String
  externalEpisodeNumber Float?
  lastSyncedAt          DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([episodeId])
}

model Genre {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  animeGenres AnimeGenre[]
  communities CommunityGenre[]
}

model AnimeGenre {
  animeId String
  genreId String

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([animeId, genreId])
  @@index([genreId])
}

model Theme {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  animeThemes AnimeTheme[]
}

model AnimeTheme {
  animeId String
  themeId String

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([animeId, themeId])
  @@index([themeId])
}

model AnimeTag {
  id             String   @id @default(cuid())
  animeId        String
  name           String
  description    String?
  rank           Int?     @default(0)
  isMediaSpoiler Boolean  @default(false)
  source         String   @default("anilist")
  createdAt      DateTime @default(now())

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([animeId, name])
  @@index([animeId])
  @@index([name])
}

model Studio {
  id                   String  @id @default(cuid())
  externalId           String?
  externalSource       String? // "anilist", "mal", "kitsu", "manual"
  name                 String  @unique // Canonical public display name
  nativeName           String? // Japanese or native Kanji / Kana
  romanizedName        String? // Romanized Japanese name
  alternativeNamesJson String? // JSON array of strings: former names, abbreviations, aliases
  slug                 String? @unique
  about                String? // Full editorial description
  shortDescription     String? // 1-2 sentence synopsis
  descriptionSource    String  @default("EDITORIAL") // "ADMIN", "PROVIDER", "EDITORIAL"

  foundedDate   DateTime?
  foundedYear   Int?
  dissolvedDate DateTime?
  status        String    @default("ACTIVE") // "ACTIVE", "INACTIVE", "CLOSED", "MERGED", "ACQUIRED", "UNKNOWN"

  country String? @default("Japan")
  region  String? // Prefecture/State, e.g. "Tokyo", "Suginami", "Kyoto"
  city    String? // City/Ward, e.g. "Mitaka", "Uji", "Musashino"

  website           String? // Canonical official website URL
  wikipediaUrl      String?
  twitterUrl        String?
  youtubeUrl        String?
  externalLinksJson String? // JSON array of { provider, externalId, url, lastVerifiedAt }

  imageUrl      String? // Primary Logo URL
  bannerUrl     String? // Banner / Key Visual URL
  logoAssetId   String? // MediaAsset reference if uploaded
  bannerAssetId String? // MediaAsset reference if uploaded

  verificationStatus String @default("UNVERIFIED") // "UNVERIFIED", "PARTIALLY_VERIFIED", "VERIFIED", "NEEDS_REVIEW"
  publicationState   String @default("PUBLISHED") // "DRAFT", "PUBLISHED", "HIDDEN", "ARCHIVED"

  // Admin Overrides (preserves raw provider data while allowing manual corrections)
  adminOverrideName        String?
  adminOverrideDescription String?
  adminOverrideFoundedYear Int?
  adminOverrideImageUrl    String?
  adminOverrideWebsite     String?
  hasAdminOverride         Boolean @default(false)
  adminNotes               String?

  metadataJson String? // JSON object with DNA, primaryGenres, artisticPhilosophy, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relationships
  animeStudios              AnimeStudio[]
  staffRelations            StudioPerson[]
  newsRelations             NewsArticleStudio[]
  parentRelationships       StudioRelationship[]      @relation("ChildStudio")
  childRelationships        StudioRelationship[]      @relation("ParentStudio")
  auditLogs                 StudioAuditLog[]
  historyEvents             StudioHistoryEvent[]
  eras                      StudioEra[]
  referencedByHistoryEvents StudioHistoryEvent[]      @relation("EventRelatedStudio")
  communities               Community[]
  versions                  StudioVersion[]
  mediaItems                StudioMedia[]
  analyticsSnapshots        StudioAnalyticsSnapshot[]
  aliases                   StudioAlias[]
  mergesAsCanonical         StudioMerge[]             @relation("CanonicalStudioMerges")
  mergesAsMerged            StudioMerge[]             @relation("MergedStudioMerges")
  redirects                 StudioRedirect[]

  @@index([slug])
  @@index([status])
  @@index([verificationStatus])
  @@index([publicationState])
  @@index([foundedYear])
}

model AnimeStudio {
  animeId          String
  studioId         String
  role             String   @default("MAIN_STUDIO") // "MAIN_STUDIO", "CO_PRODUCER", "ANIMATION", "PRODUCTION_ASSISTANCE", "CG", "BACKGROUND", "OTHER"
  isMain           Boolean  @default(true) // Backwards compatibility with existing queries
  isPrimary        Boolean  @default(true) // Designated lead studio among multiple studios
  productionStatus String?  @default("COMPLETED")
  source           String?  @default("CANONICAL") // "CANONICAL", "ANILIST", "MAL", "ADMIN_OVERRIDE"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  anime  Anime  @relation(fields: [animeId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@id([animeId, studioId])
  @@index([studioId])
  @@index([animeId])
  @@index([isPrimary])
}

model StudioPerson {
  id              String   @id @default(cuid())
  studioId        String
  personId        String
  role            String // "FOUNDER", "CO_FOUNDER", "CEO", "DIRECTOR", "PRODUCER", "EXECUTIVE", "KEY_STAFF"
  tenureStartYear Int?
  tenureEndYear   Int?
  isCurrent       Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([studioId, personId, role])
  @@index([studioId])
  @@index([personId])
  @@index([role])
}

model StudioRelationship {
  id               String   @id @default(cuid())
  parentStudioId   String
  childStudioId    String
  relationshipType String // "SUBSIDIARY", "PARENT_COMPANY", "SISTER_STUDIO", "MERGED_INTO", "SUCCESSOR", "SPIN_OFF"
  establishedYear  Int?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parentStudio Studio @relation("ParentStudio", fields: [parentStudioId], references: [id], onDelete: Cascade)
  childStudio  Studio @relation("ChildStudio", fields: [childStudioId], references: [id], onDelete: Cascade)

  @@unique([parentStudioId, childStudioId, relationshipType])
  @@index([parentStudioId])
  @@index([childStudioId])
}

model StudioEra {
  id           String    @id @default(cuid())
  studioId     String
  name         String // e.g. "Founding & Dezaki Era", "Golden Era", "Modern Expansion"
  description  String?
  startDate    DateTime?
  startYear    Int?
  endDate      DateTime?
  endYear      Int?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  studio Studio               @relation(fields: [studioId], references: [id], onDelete: Cascade)
  events StudioHistoryEvent[]

  @@index([studioId, displayOrder])
}

model StudioHistoryEvent {
  id               String  @id @default(cuid())
  studioId         String
  eraId            String?
  title            String
  shortDescription String?
  fullDescription  String?

  eventDate    DateTime?
  eventYear    Int?
  eventEndDate DateTime?
  eventEndYear Int?

  eventType    String @default("MILESTONE") // "FOUNDING", "NAME_CHANGE", "LEADERSHIP", "MAJOR_PROJECT", "COMPANY_CHANGE", "ACQUISITION", "MERGER", "EXPANSION", "OFFICE_CHANGE", "AWARD", "MILESTONE", "STAFF_CHANGE", "PRODUCTION_EVENT", "OTHER"
  importance   String @default("NORMAL") // "LOW", "NORMAL", "IMPORTANT", "MAJOR", "CRITICAL"
  displayOrder Int    @default(0)

  imageUrl     String?
  imageCaption String?
  imageAltText String?

  personId        String?
  animeId         String?
  relatedStudioId String?

  source     String? // Source Name
  sourceUrl  String? // Source Link
  sourceType String  @default("OFFICIAL") // "OFFICIAL", "DATABASE", "ARCHIVE", "INTERVIEW", "NEWS", "BOOK", "PUBLICATION", "OTHER"

  verificationStatus String @default("UNVERIFIED") // "UNVERIFIED", "NEEDS_REVIEW", "PARTIALLY_VERIFIED", "VERIFIED"
  publicationState   String @default("PUBLISHED") // "DRAFT", "PUBLISHED", "HIDDEN", "ARCHIVED"

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  studio        Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  era           StudioEra? @relation(fields: [eraId], references: [id], onDelete: SetNull)
  person        Person?    @relation(fields: [personId], references: [id], onDelete: SetNull)
  anime         Anime?     @relation(fields: [animeId], references: [id], onDelete: SetNull)
  relatedStudio Studio?    @relation("EventRelatedStudio", fields: [relatedStudioId], references: [id], onDelete: SetNull)

  @@index([studioId, eventYear, displayOrder])
  @@index([studioId, publicationState])
  @@index([studioId, importance])
  @@index([studioId, eventType])
  @@index([animeId])
  @@index([personId])
}

model StudioAuditLog {
  id        String   @id @default(cuid())
  studioId  String
  actorId   String
  action    String // "CREATE", "UPDATE", "ARCHIVE", "RESTORE", "IMAGE_UPDATE", "ANIME_LINK", "ANIME_UNLINK", "PERSON_LINK", "PERSON_UNLINK", "MERGE", "OVERRIDE_APPLY", "OVERRIDE_RESET", "VERIFICATION_CHANGE", "HISTORY_EVENT_CREATE", "HISTORY_EVENT_UPDATE", "HISTORY_EVENT_PUBLISH", "HISTORY_EVENT_ARCHIVE", "HISTORY_EVENT_VERIFY"
  oldValues String? // JSON snapshot of previous values
  newValues String? // JSON snapshot of new values
  reason    String?
  ipAddress String?
  createdAt DateTime @default(now())

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([studioId, createdAt])
  @@index([actorId])
  @@index([action])
}

model StudioVersion {
  id             String   @id @default(cuid())
  studioId       String
  versionNumber  Int
  authorId       String
  snapshotJson   String // Serialized Studio metadata snapshot
  changesSummary String?
  createdAt      DateTime @default(now())

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([studioId, versionNumber])
  @@index([studioId])
  @@index([authorId])
}

model StudioMedia {
  id            String   @id @default(cuid())
  studioId      String
  mediaType     String // "LOGO", "BANNER", "MAIN_IMAGE", "GALLERY"
  url           String
  assetId       String?
  source        String?
  attribution   String?
  status        String   @default("APPROVED") // "PENDING", "APPROVED", "REJECTED"
  uploadedById  String
  mimeType      String?
  fileSizeBytes Int?
  width         Int?
  height        Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  studio     Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("StudioMediaUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([mediaType])
  @@index([status])
}

model StudioAnalyticsSnapshot {
  id                String   @id @default(cuid())
  studioId          String
  period            String // "ALL_TIME", "LAST_12_MONTHS", "LAST_90_DAYS", "LAST_30_DAYS", "LAST_7_DAYS"
  metricVersion     String   @default("v1")
  projectCount      Int      @default(0)
  averageScore      Float?
  ratingCount       Int      @default(0)
  watchCount        Int      @default(0)
  completionCount   Int      @default(0)
  communityActivity Int      @default(0)
  newsActivity      Int      @default(0)
  momentumScore     Float    @default(0.0)
  snapshotDataJson  String // Complete serialized snapshot payload
  generatedAt       DateTime @default(now())

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, period, metricVersion])
  @@index([studioId])
  @@index([period])
  @@index([generatedAt])
}

model StudioAlias {
  id              String   @id @default(cuid())
  studioId        String
  alias           String
  normalizedAlias String
  language        String?  @default("en") // "en", "ja", "ja-ro", etc.
  aliasType       String   @default("ALTERNATIVE") // "OFFICIAL", "NATIVE", "ROMANIZED", "FORMER", "ABBREVIATION", "ALTERNATIVE", "COMMON_NAME", "IMPORT_NAME"
  source          String?  @default("MANUAL")
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, normalizedAlias])
  @@index([normalizedAlias])
  @@index([studioId])
  @@index([aliasType])
}

model StudioMerge {
  id                         String   @id @default(cuid())
  canonicalStudioId          String
  mergedStudioId             String
  initiatedById              String
  reason                     String?
  confidenceScore            Float    @default(1.0)
  relationshipsMigratedCount Int      @default(0)
  status                     String   @default("COMPLETED") // "COMPLETED", "ROLLED_BACK", "FAILED"
  rollbackAvailable          Boolean  @default(true)
  snapshotDataJson           String // Serialized state before merge for exact rollback
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @default(now()) @updatedAt

  canonicalStudio Studio @relation("CanonicalStudioMerges", fields: [canonicalStudioId], references: [id], onDelete: Cascade)
  mergedStudio    Studio @relation("MergedStudioMerges", fields: [mergedStudioId], references: [id], onDelete: Cascade)
  initiatedBy     User   @relation("StudioMergeInitiator", fields: [initiatedById], references: [id], onDelete: Cascade)

  @@index([canonicalStudioId])
  @@index([mergedStudioId])
  @@index([initiatedById])
  @@index([status])
}

model StudioRedirect {
  id                String   @id @default(cuid())
  sourceIdentifier  String   @unique // Source ID or Slug (e.g. old/merged studio ID or slug)
  canonicalStudioId String
  redirectType      String   @default("MERGE") // "MERGE", "SLUG_CHANGE", "LEGACY_ID"
  createdAt         DateTime @default(now())

  canonicalStudio Studio @relation(fields: [canonicalStudioId], references: [id], onDelete: Cascade)

  @@index([sourceIdentifier])
  @@index([canonicalStudioId])
}

model Producer {
  id         String  @id @default(cuid())
  externalId String?
  name       String  @unique
  slug       String? @unique
  about      String?
  website    String?
  imageUrl   String?

  animeProducers AnimeProducer[]
}

model AnimeProducer {
  animeId    String
  producerId String

  anime    Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  producer Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@id([animeId, producerId])
  @@index([producerId])
}

model Licensor {
  id   String @id @default(cuid())
  name String @unique

  animeLicensors AnimeLicensor[]
}

model AnimeLicensor {
  animeId    String
  licensorId String

  anime    Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  licensor Licensor @relation(fields: [licensorId], references: [id], onDelete: Cascade)

  @@id([animeId, licensorId])
  @@index([licensorId])
}

model Person {
  id         String  @id @default(cuid())
  externalId String?
  name       String
  slug       String? @unique
  nameKanji  String?
  about      String?
  birthday   String?
  website    String?
  imageUrl   String?

  // Provider ids (2026-10-18): people are matched by these, not by name —
  // two different people can share a name.
  anilistId             Int?      @unique
  malId                 Int?      @unique
  // Creator details from AniList (plain text; null when the source has none).
  homeTown              String?
  yearsActive           String? // e.g. "1998–present"
  dateOfDeath           String?
  occupations           String[]  @default([])
  detailsFetchedAt      DateTime?
  // More profile facts from AniList (2026-10-19); null/empty when the source has none.
  alternativeNames      String[]  @default([])
  gender                String?
  bloodType             String?
  language              String? // e.g. "Japanese" (AniList languageV2)
  anilistFavourites     Int? // AniList members who favourited them
  extraDetailsFetchedAt DateTime?

  staffRoles      AnimeStaff[]
  voiceRoles      CharacterVoiceActor[]
  newsRelations   NewsArticlePerson[]
  studioRelations StudioPerson[]
  historyEvents   StudioHistoryEvent[]
}

model Character {
  id         String  @id @default(cuid())
  externalId String?
  name       String
  slug       String? @unique
  nameKanji  String?
  about      String?
