# ANILOG Environment Configuration Example

# Database (PostgreSQL — migrated from SQLite 2026-09-14, see
# docs/production/RUNBOOK.md's Postgres section for the cutover and
# scripts/migrate_sqlite_to_postgres.ts for the one-time data copy).
# A local dev server: role `otakuva`, database `otakuva`, both created
# once via `CREATE ROLE otakuva LOGIN CREATEDB; CREATE DATABASE otakuva
# OWNER otakuva;` as a Postgres superuser. `CREATEDB` is only needed so
# `npm test` can create/drop its own throwaway per-run databases (see
# TEST_DATABASE_ADMIN_URL below) — the app itself never creates databases.
DATABASE_URL="postgresql://otakuva:password@localhost:5432/otakuva"

# Admin connection `npm test` uses to CREATE/DROP a throwaway database per
# test file (tests/helpers/setupTestDb.ts) — points at the same server's
# `postgres` maintenance database (CREATE DATABASE needs a database to
# connect *from*), using the same `otakuva` role above via its CREATEDB
# grant. Only used by the test suite; the running app never touches this.
# If unset, the tests use DATABASE_URL with the database swapped for
# `postgres` (tests/helpers/adminDatabaseUrl.ts). Never commit a real password.
TEST_DATABASE_ADMIN_URL="postgresql://otakuva:password@localhost:5432/postgres"

# External Data Provider (Jikan API - Phase 3)
JIKAN_BASE_URL="https://api.jikan.moe/v4"

# AniList GraphQL endpoint and optional token
ANILIST_BASE_URL="https://graphql.anilist.co"
# Optional: provide an AniList API token if available (for higher rate limits / private data)
ANILIST_TOKEN=""

# Preferred provider: "jikan" or "anilist". If empty, provider selection is automatic.
ANILOG_PROVIDER=""

# How long src/lib/providers/failoverProvider.ts waits for the preferred
# provider before failing over to the other registered one. Optional —
# defaults to 20000 (20s) if unset.
PROVIDER_FAILOVER_TIMEOUT_MS=""

# Background job queue (BullMQ). Required by scripts/worker.ts — the
# process that actually runs sync/import/news/schedule jobs enqueued by
# POST /api/admin/sync, POST /api/admin/anime/import, and the queue's own
# recurring news/schedule jobs (src/lib/queue/recurring.ts). Without a
# reachable Redis, those routes still enqueue successfully (Redis writes
# succeed), but nothing ever processes the jobs — see
# docs/production/RUNBOOK.md §6.
REDIS_URL="redis://127.0.0.1:6379"

# Authentication Secrets (Phase 5)
AUTH_SECRET="your-32-character-random-auth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# RBAC bootstrap: comma-separated emails to auto-promote to SUPER_ADMIN on
# their next login/registration. This is the only way to create the first
# SUPER_ADMIN account (there's no other way to get an admin without direct
# DB access). Once at least one SUPER_ADMIN exists, further role changes go
# through PATCH /api/admin/users/:id/role instead of this env var.
OTAKUVA_SUPER_ADMIN_EMAILS=""

# Cloudflare R2 Production Media Storage
# Object storage for authenticated user profile media (avatars and banners)
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID="0633c7571e5c9ccb6f49c6f197b707c0"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="otakuva-media"
R2_ENDPOINT="https://0633c7571e5c9ccb6f49c6f197b707c0.r2.cloudflarestorage.com"
MEDIA_PUBLIC_URL="https://media.otakuva.com"


# Optional: GIF search in comments (GIPHY). Server-side only — never prefix
# with NEXT_PUBLIC_. Without it the GIF picker says search isn't set up and
# people can still attach a GIF by uploading the file.
GIPHY_API_KEY=""

# Error tracking (Sentry — see docs/production/RUNBOOK.md's "Error
# tracking" section). Entirely optional: unset means Sentry.init runs with
# `enabled: false` (sentry.server.config.ts / sentry.edge.config.ts /
# src/instrumentation-client.ts) — no events sent, no behavior change,
# nothing required to develop or run this app without a Sentry account.
# Server + edge runtimes:
SENTRY_DSN=""
# Browser: needs its own NEXT_PUBLIC_-prefixed var (this ships in the
# client bundle — the DSN is meant to be public, it's not a secret, but
# it's kept separate from SENTRY_DSN so what's client-visible stays explicit).
NEXT_PUBLIC_SENTRY_DSN=""
# Optional — defaults to NODE_ENV if unset.
SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
# Optional, build-time only — lets `next build`'s Sentry webpack plugin
# upload source maps and tag the release. Without these the build just
# skips that step silently; runtime error capture above works either way.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Base URL used to build links in outbound emails (password reset, email
# verification — see src/app/api/auth/password-reset/**,
# src/app/api/auth/email/verify/**). Defaults to http://localhost:3000 if
# unset; set to the real public URL in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Outbound email delivery (password reset links for legacy email accounts) via Resend
# (https://resend.com). Server-side only — never prefix with NEXT_PUBLIC_.
# EMAIL_FROM must use a domain you've verified in Resend, e.g.
# "OTAKUVA <no-reply@yourdomain.com>". For quick testing before a domain is
# verified, "OTAKUVA <onboarding@resend.dev>" works but can only deliver to
# the email address on your own Resend account. With either variable unset,
# src/lib/email/emailSender.ts logs the message (link included) instead.
RESEND_API_KEY=""
EMAIL_FROM=""

# Phone sign-up / sign-in / phone linking: SMS one-time codes via Twilio
# Verify (https://www.twilio.com/docs/verify). Server-side only — never
# prefix with NEXT_PUBLIC_. Create a Verify Service once in the Twilio
# Console (Verify → Services) and put its VA… SID here. Enable Fraud Guard
# and restrict Geo Permissions to the countries you actually serve.
# With these unset in development, src/lib/identity/otpService.ts prints
# each code to the server log instead of texting it. In production, unset
# means nobody can sign in or sign up — it fails closed.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Phone identity rollout switches (src/lib/identity/identityConfig.ts).
# PHONE_VERIFICATION_REQUIRED="true" makes rating/reviewing/posting require
# a verified phone — set it before going public. PHONE_OTP_MODE="mock"
# skips SMS and shows the code in the sign-in form; development only, it
# is ignored when NODE_ENV=production.
PHONE_VERIFICATION_REQUIRED="false"
PHONE_OTP_MODE=""

# Control-center gate (step one): SHA-256 (hex) of the owner key typed into the
# normal sign-in password box. Required in production, or /control is closed.
# Make one with: node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" <key>
CONTROL_GATE_KEY_SHA256=""

# Google sign-in (2026-11-04) — replaces phone/SMS verification.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorised redirect URI: <your site>/api/auth/google/callback
#   e.g. http://localhost:3000/api/auth/google/callback and the production URL.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: override the redirect URI (otherwise built from NEXT_PUBLIC_APP_URL / the request host).
GOOGLE_REDIRECT_URI=""

# Email via Gmail (2026-11-04) — sign-up codes + welcome email, no domain needed.
# SMTP_USER = the Gmail address that sends; SMTP_PASS = a 16-letter App Password
# (myaccount.google.com/apppasswords, needs 2-Step Verification). ~500 emails/day.
# Takes priority over Resend when set. EMAIL_FROM can be just a name ("OTAKUVA").
SMTP_USER=""
SMTP_PASS=""

# Business contact on /support (2026-11-04). Empty = section hidden.
NEXT_PUBLIC_BUSINESS_EMAIL=""
