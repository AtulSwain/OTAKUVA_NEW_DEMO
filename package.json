{
  "name": "anilog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "predev": "npm run clean && prisma generate",
    "dev": "next dev",
    "predev:turbo": "npm run clean && prisma generate",
    "dev:turbo": "next dev --turbo",
    "prebuild": "npm run clean && npm run check:providers && prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:providers": "node scripts/check_provider_calls.mjs",
    "pretest": "npm run check:providers",
    "test": "tsx --test tests/*.test.ts",
    "worker": "tsx scripts/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@mateoaranda/jikanjs": "^1.3.1",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.74.0",
    "@types/sharp": "^0.31.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.6",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.460.0",
    "next": "^14.2.20",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.6",
    "@types/opentype.js": "^1.3.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.20",
    "opentype.js": "^2.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  }
}
