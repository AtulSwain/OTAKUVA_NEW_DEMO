{
  "name": "anilog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "predev": "npm run clean && prisma generate",
    "dev": "next dev",
    "predev:turbo": "npm run clean && prisma generate",
    "dev:turbo": "next dev --turbo",
    "prebuild": "npm run clean && npm run check:providers && prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:providers": "node scripts/check_provider_calls.mjs",
    "pretest": "npm run check:providers",
    "test": "tsx --test tests/*.test.ts",
    "worker": "tsx scripts/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@mateoaranda/jikanjs": "^1.3.1",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.10.0",
    "@types/sharp": "^0.31.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.1",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.63.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "opentype.js": "^2.0.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
